# Copie este arquivo para ".env" e preencha os valores.
# NUNCA envie o .env para o GitHub (contem segredos).

# Token do bot (Discord Developer Portal > Bot > Reset Token)
BOT_TOKEN=

# ID da aplicacao (Discord Developer Portal > General Information > Application ID)
BOT_CLIENT_ID=

# ID do servidor (Discord > Ativar modo desenvolvedor > Copiar ID do servidor)
BOT_GUILD_ID=

# =============================
# Tickets • Pré-atendimento (Opcional)
# =============================
# O pré-atendimento (coleta inicial) é configurável via `/botconfig` → Tickets.
# Não há integração externa de IA neste projeto.
